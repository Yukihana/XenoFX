{
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:9600" }
    }
  },
  "XenoServeOptions": {
    "StartupPath": "",
    "UseCommandLine": true,
    "_comment": "Leave StartupPath empty for default path"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "XenoServe": "Information",
      "XenoFx": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Mvc.Infrastructure": "Error",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}