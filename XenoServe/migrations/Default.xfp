{
  "AssetsDatabasePath": "XenoAssets.sqlite",
  "TempDatabasePath": "Temp.sqlite",
  "AssetsDirectory": "Assets",
  "AssetUploadDirectory": "Uploads",
  "CacheDirectory": "Cache",
  "ThumbsDirectory": "Thumbs",
  "AssetFilterConfig": {
    "Greylist": [
      "**/*.*"
