@using XenoServe.Data
@model XenoServe.Features.AssetViewer.AssetViewerViewModel
@{
    Layout = Model.RenderType == ViewRenderType.IFrame ? "_EmbeddedIFrameLayout" : null;
    ViewData["Title"] = "Asset Viewer";

    var mimeType = Model.MimeType;
    var sourceUrl = Model.SourceUrl;
    var title = Model.Title;
}

<div class="media-container">
    @if(string.IsNullOrEmpty(mimeType) || string.IsNullOrEmpty(sourceUrl))
    {
        <p>No media available.</p>
    }
    else if (mimeType.StartsWith("image"))
    {
        <img src="@sourceUrl" alt="@title" />
    }
    else if (mimeType.StartsWith("audio"))
    {
        <audio controls autoplay>
            <source src="@sourceUrl" type="@mimeType">
            Your browser does not support the audio tag.
        </audio>
    }
    else if (mimeType.StartsWith("video"))
    {
        <video controls autoplay style="width:100%;height:100%;object-fit:contain;display:block;">
            <source src="@sourceUrl" type="@mimeType">
            Your browser does not support the video tag.
        </video>
    }
    else
    {
        <p>Unsupported Media Type. [ <a href="@sourceUrl">Open</a> ]</p>
    }
</div>